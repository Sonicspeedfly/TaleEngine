# Секреты (и их резервные копии: scrub_secrets.py оставляет .env.bak-<дата>)
.env
.env.bak*

# База данных и данные среды выполнения
data/*.db
data/*.db-*
*.sqlite3

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Node / frontend
frontend/node_modules/
frontend/dist/

# IDE
.vscode/
.idea/
data/*.bak*

# Состояние локального сервера вопросов impeccable (pid, порт, пульс) — не часть дизайн-системы
.impeccable/questions/

# Локальные копии CDN-библиотек (см. serve_index): у каждого сервера свои
frontend/vendor/
# Резервные копии, которые делают руками на сервере (app.js.bak и т.п.)
*.bak
