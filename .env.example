# Скопируйте этот файл в .env и заполните нужные значения.
#   cp .env.example .env

# ===== Сервер =====
APP_NAME=AiChat SSF
HOST=0.0.0.0
PORT=8000
DEBUG=false
# Через запятую — какие origin'ы фронтенда пускать (CORS).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ===== База данных (ОБЩАЯ для backend и Telegram-бота) =====
DATABASE_URL=sqlite+aiosqlite:///./data/aichat.db

# ===== LLM / LiteLLM =====
# DEFAULT_MODEL — имя модели КАК ОНО НАЗВАНО в вашем LiteLLM-прокси.
DEFAULT_MODEL=gpt-4o
REQUEST_TIMEOUT=120
# Пауза (сек) между ответами персонажей в ГРУППОВОМ чате — защита от 429
# RESOURCE_EXHAUSTED, когда подряд отвечают несколько (+A +B +C). 0 = без паузы.
# Переопределяется в UI (Генерация -> «Пауза между ответами в группе»).
GROUP_REPLY_DELAY=3
# Сколько раз LiteLLM повторит запрос при сбое/лимите (429) с бэкоффом.
LLM_NUM_RETRIES=3
# Минимальный таймаут для БОЛЬШИХ мультимодальных запросов (inline-видео/аудио > 8 МБ):
# заливка в прокси/Vertex и обработка медиа занимают дольше обычного текста.
# Реальный таймаут ещё и растёт с размером файла (~10 с/МБ, потолок 30 минут).
LARGE_REQUEST_TIMEOUT=900
# ----- Расход квоты (сколько токенов уходит провайдеру на КАЖДОМ ходу) -----
# Всё ниже переопределяется в UI: Генерация -> «💰 Расход квоты».
# Окно контекста («память» диалога, ~токенов истории на ход). ВАЖНО: у Gemini
# вход свыше ~200 тыс. токенов тарифицируется вдвое дороже ЦЕЛИКОМ, поэтому
# 200 тыс. — «бесплатная» граница. Больше = помнит дальше, но заметно дороже.
CONTEXT_TOKEN_BUDGET=200000
# Лимит ФАЙЛОВ истории (МБ на ход): прежние вложения пересылаются модели заново,
# чтобы она их «видела». 0 = БЕЗ лимита (полная память по файлам, дорого).
HISTORY_FILES_MB=8
# ...и только из N последних сообщений (0 = без ограничения по возрасту).
# Главный рычаг экономии в долгих чатах: без окна одно присланное видео уходит
# провайдеру заново на КАЖДОМ ходу до конца чата. Вне окна — текстовая пометка.
HISTORY_FILES_TURNS=12
# Потолок текста базы знаний В КОНТЕКСТЕ (символы; 0 = без ограничения).
# База уходит в каждый запрос: 200 000 символов ≈ 50 тыс. токенов входа на ход.
KNOWLEDGE_TEXT_CHARS=60000
# Сколько символов транскрипта видит ИИ-режиссёр группы (0 = весь чат).
# Это ОТДЕЛЬНЫЙ запрос на каждый ход группы — ради одного слова «кто следующий».
DIRECTOR_TRANSCRIPT_CHARS=4000
# Каждые сколько сообщений обновляется авто-сводка сюжета. Тоже отдельный
# платный запрос: реже = дешевле, чаще = точнее «долгая память».
AUTO_SUMMARY_EVERY=10

# ===== LiteLLM Proxy (основной путь) =====
# У вас прокси уже запущен на :4000 — всё уходит туда, ключи провайдеров живут в прокси.
# Эти значения можно менять прямо в интерфейсе (вкладка «Подключение»).
LITELLM_USE_PROXY=true
LITELLM_BASE_URL=http://localhost:4000
# master key прокси (если включён), формата sk-...
LITELLM_API_KEY=

# Дефолтные параметры генерации (переопределяются на уровне персонажа/UI)
DEFAULT_TEMPERATURE=0.9
DEFAULT_TOP_P=0.95
DEFAULT_TOP_K=40
DEFAULT_MAX_TOKENS=1024
DEFAULT_REPETITION_PENALTY=1.1

# ===== Ключи провайдеров (заполните те, что используете) =====
# LiteLLM читает их из окружения автоматически по имени модели.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Для Vertex AI: проект GCP и регион (плюс GOOGLE_APPLICATION_CREDENTIALS при необходимости).
VERTEX_PROJECT=
VERTEX_LOCATION=us-central1

# ===== Telegram =====
# ============================================================
# СЕКРЕТЫ ДОСТУПА
# ============================================================
# Заданные здесь значения ПЕРЕКРЫВАЮТ то, что лежит в базе, и становятся
# недоступны для правки из интерфейса (поля помечаются замком).
#
# Зачем: раньше пароль администратора, код доступа и токен бота хранились в
# таблице app_settings ОТКРЫТЫМ ТЕКСТОМ. Резервная копия базы, её экспорт или
# чужой доступ к файлу означали компрометацию всего сразу.
#
# После переноса значения из базы можно вычистить:
#     python scripts/scrub_secrets.py
# Скрипт делает резервную копию и спрашивает подтверждение.

# Пароль администратора. Пусто — берётся из базы, как раньше.
ADMIN_PASSWORD=

# Код доступа ко всему приложению. Пусто — берётся из базы.
ACCESS_CODE=

TELEGRAM_BOT_TOKEN=
# Автозапуск бота при старте. Поставьте false на ВТОРОМ/тестовом инстансе с той
# же БД (локальная копия для отладки) — иначе два процесса опрашивают одного бота
# и Telegram отдаёт Conflict 409. На боевом сервере оставьте true (или не задавайте).
TELEGRAM_AUTOSTART=true
# С каким персонажем начинать чат в Telegram, если у пользователя ещё нет сессии
# (id персонажа из веб-интерфейса). Оставьте строку ЗАКОММЕНТИРОВАННОЙ, если не нужно
# (пустое значение тоже допустимо — трактуется как «не задано»).
# TELEGRAM_DEFAULT_CHARACTER_ID=1
